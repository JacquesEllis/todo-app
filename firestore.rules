rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Deny all reads and writes to every path, for every user.
    // No collections are in use during the Hello World smoke test.
    // Full collection-level rules will be added in a subsequent card
    // once the data model is implemented.
    match /{document=**} {
      allow read, write: if false;
    }

  }
}
