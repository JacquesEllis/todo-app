# Copy this file to .env.local and fill in your values for local development.
# NEVER commit .env.local to version control.
#
# Vite requires the VITE_ prefix to expose variables to the browser bundle.
# The GitHub Actions workflow maps the unprefixed secrets to these names.

VITE_GRAPHQL_API_URL=http://localhost:5001/ai-bot-experiment/us-central1/api/graphql
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
