# Local development environment variables
# Copy this file and fill in real values — never commit secrets

# GraphQL API
VITE_GRAPHQL_API_URL=http://localhost:5001/ai-bot-experiment/us-central1/api/graphql

# Firebase config (get from Firebase Console > Project Settings)
VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=ai-bot-experiment.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=ai-bot-experiment
VITE_FIREBASE_STORAGE_BUCKET=ai-bot-experiment.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id-here
VITE_FIREBASE_APP_ID=your-app-id-here
